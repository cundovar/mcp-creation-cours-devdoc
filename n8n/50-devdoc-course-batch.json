    {
      "parameters": {
        "jsCode": "const request = $('Validate Formation Batch').first().json;\nconst preparedMenus = $json.data?.menus || [];\nif (preparedMenus.length !== request.menus.length) {\n  throw new Error('Prepared menu count does not match requested menu count');\n}\nreturn request.menus.flatMap((menu, index) => {\n  const menuId = Number(preparedMenus[index]?.id);\n  if (!Number.isInteger(menuId) || menuId < 1) throw new Error('Prepared menu id is missing');\n  return menu.generationIds.map((generationId) => ({\n    json: { generationId, menuId },\n    pairedItem: { item: 0 }\n  }));\n});"
      },
