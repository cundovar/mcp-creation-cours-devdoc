        "jsCode": "const input = $json.body ?? $json;\nconst source = Array.isArray(input.generationIds)\n  ? input.generationIds\n  : [input.generationId];\nconst generationIds = [...new Set(source.map(Number))]\n  .filter((id) => Number.isInteger(id) && id > 0);\nif (!generationIds.length) throw new Error('generationIds is required');\nif (generationIds.length > 100) throw new Error('A batch cannot exceed 100 generations');\nreturn generationIds.map((generationId) => ({ json: { generationId } }));"
