    {
      "parameters": {
        "jsCode": "const input = $json.body ?? $json;\nconst batchId = String(input.batchId || '').trim();\nconst superMenu = String(input.superMenu || '').trim();\nconst category = String(input.category || '').trim();\nif (!/^[A-Za-z0-9._:-]{8,100}$/.test(batchId)) throw new Error('batchId is invalid');\nif (!superMenu) throw new Error('superMenu is required');\nif (!category) throw new Error('category is required');\nif (!Array.isArray(input.menus) || input.menus.length < 1 || input.menus.length > 20) {\n  throw new Error('menus must contain between 1 and 20 entries');\n}\nconst seen = new Set();\nlet count = 0;\nconst menus = input.menus.map((menu) => {\n  const name = String(menu.name || '').trim();\n  const level = String(menu.level || '').trim();\n  const position = String(menu.position || 'menu-gauche').trim();\n  if (!name || !level) throw new Error('Each menu needs name and level');\n  const generationIds = [...new Set((menu.generationIds || []).map(Number))]\n    .filter((id) => Number.isInteger(id) && id > 0);\n  if (!generationIds.length) throw new Error('Each menu needs generationIds');\n  for (const id of generationIds) {\n    if (seen.has(id)) throw new Error('generationIds must be unique across the batch');\n    seen.add(id);\n    count += 1;\n  }\n  return { name, level, position, generationIds };\n});\nif (count > 50) throw new Error('A batch cannot exceed 50 generations');\nreturn [{ json: { batchId, superMenu, category, menus } }];"
      },
