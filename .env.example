# Configuration de l'environnement
NODE_ENV=development
REPOSITORY_DRIVER=symfony

# Configuration MySQL legacy (uniquement si REPOSITORY_DRIVER=mysql)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=change_me
DB_USER=change_me
DB_PASSWORD=change_me

# Configuration API Symfony
SYMFONY_API_BASE_URL=http://localhost:8080
N8N_API_KEY=change_me_symfony_api_key
SYMFONY_API_NIVEAUX_PATH=/api/admin/niveau-cours

# Mode d'exécution des appels IA texte: direct | bridge
# direct = appel API DeepSeek depuis ce service
# bridge = délégation à cli-agent-bridge via socket Unix (aucune clé DeepSeek requise)
AI_EXECUTION_MODE=direct
CLI_AGENT_BRIDGE_SOCKET=/run/cli-agent-bridge/bridge.sock
CLI_AGENT_BRIDGE_PROJECT=devdoc
CLI_AGENT_BRIDGE_TOKEN=change_me_bridge_token
CLI_AGENT_BRIDGE_TIMEOUT_MS=310000

# Configuration de l'API DeepSeek (inutile si AI_EXECUTION_MODE=bridge)
DEEPSEEK_API_KEY=votre_cle_api_deepseek

# Images et vérification indépendante OpenAI (toujours en appel direct, requis dans les deux modes)
OPENAI_API_KEY=change_me_openai_api_key
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_VERIFIER_MODEL=gpt-5-mini

# Configuration du serveur HTTP
HTTP_PORT=3000
HTTP_CORS_ORIGIN=*
# Obligatoire pour les appels n8n vers l’API HTTP du MCP
ORCHESTRATION_API_TOKEN=change_me_long_random_token

# Configuration des logs
LOG_LEVEL=info

# Profil des migrations: default | appy
MIGRATION_PROFILE=appy
