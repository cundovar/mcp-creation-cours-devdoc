# Configuration de l'environnement
NODE_ENV=development
REPOSITORY_DRIVER=symfony

# Configuration de la base de données MySQL
# Ancienne BDD en ligne (commentée)
# DB_HOST=egflbugcundo.mysql.db
# DB_PORT=3306
# DB_NAME=egflbugcundo
# DB_USER=egflbugcundo
# DB_PASSWORD=Kryska10

# BDD locale Symfony (selon .env)
DB_HOST=db
DB_PORT=3306
DB_NAME=courto
DB_USER=root
DB_PASSWORD=root

# Configuration API Symfony
SYMFONY_API_BASE_URL=http://localhost:8080
N8N_API_KEY=votre_api_key_symfony
SYMFONY_API_NIVEAUX_PATH=/api/admin/niveau-cours

# Configuration de l'API DeepSeek
DEEPSEEK_API_KEY=votre_cle_api_deepseek

# Configuration du serveur HTTP
HTTP_PORT=3000
HTTP_CORS_ORIGIN=*

# Configuration des logs
LOG_LEVEL=info

# Profil des migrations: default | appy
MIGRATION_PROFILE=appy
